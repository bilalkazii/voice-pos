# Android / Gradle / iOS build output
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/.cxx/
ios/build/
ios/Pods/
**/Flutter/ephemeral/
**/GeneratedPluginRegistrant.*

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing material — never commit keystores or passwords.
# Keystore files live outside the repository; android/key.properties
# points at them (see android/key.properties.example).
key.properties
*.jks
*.keystore
*.keystore.id
*.mobileprovision
*.p12
*.pfx
*.p8
*.cer
*.certSigningRequest

# Environment and secrets — this app is offline-only and has no .env, but
# ignore the pattern anyway so a future backend integration cannot leak one.
.env
.env.*
!.env.example
*.pem
*.key

# Archives
*.zip
*.apk
*.aab
*.ipa

# Widget Preview related
.widget_preview/
